# Postgres connection string. Defaults to the local docker-compose
# Postgres (see docker-compose.yml, port 5434) if unset (models/base.py).
DATABASE_URL=postgresql+psycopg2://capacity:capacity@localhost:5434/capacity

# Comma-separated list of origins allowed to call /graphql cross-origin
# (see app.py). There's no auth (ADR-004), so this is the only thing
# stopping an arbitrary site from moving jobs on the board — set it to
# the deployed frontend's exact origin, no trailing slash. Defaults to
# the local Next.js dev server if unset.
FRONTEND_ORIGIN=http://localhost:3000
